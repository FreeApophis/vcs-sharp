<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>vcs</AssemblyName>
    <RootNamespace>VirtualContactSheet.Cli</RootNamespace>
  </PropertyGroup>

  <!-- Distributed as a .NET global tool: `dotnet tool install -g VirtualContactSheet.Cli`, run as `vcs`. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vcs</ToolCommandName>
    <PackageId>VirtualContactSheet.Cli</PackageId>
    <Version>2.0.0</Version>
    <Authors>Thomas Bruderer</Authors>
    <Description>Command-line tool (vcs) for VirtualContactSheet: generates contact sheets from video files, from folders of images, or from image files. Video input requires ffmpeg/ffprobe on PATH; image input requires neither.</Description>
    <PackageTags>contact-sheet;video;image;photo;thumbnail;cli;dotnet-tool;ffmpeg</PackageTags>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/FreeApophis/vcs-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FreeApophis/vcs-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualContactSheet\VirtualContactSheet.csproj" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VirtualContactSheet.Test" />
  </ItemGroup>

  <!-- SkiaSharp ships native debug symbols next to its native libraries (libSkiaSharp.pdb is
       ~100 MB for each of win-x64/x86/arm64). A global tool packs its whole publish output, so
       those symbols alone quadrupled the download - 34 MB at 1.0.0, 143 MB at 1.0.1 after the
       SkiaSharp bump - for files nothing needs at runtime. Drop them from the tool package;
       managed symbols for our own code still ship in the library's .snupkg. -->
  <Target Name="RemoveNativeSymbolsFromToolPackage" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb' AND $([System.String]::new('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes'))" />
    </ItemGroup>
  </Target>

  <!-- Copy platform-specific ffmpeg binaries into the build output so the CLI works without a global install.
       BundleFfmpeg defaults true (for dev build/run); the tool-pack steps set it false so the global-tool
       package stays lean and tool users supply ffmpeg/ffprobe on PATH.

       The binaries are git-ignored (see tools/download-ffmpeg.ps1), so each Content item is
       guarded by Exists(): bundling is an optimization, and a clean checkout must still build.
       Without them the CLI falls back to ffmpeg/ffprobe on PATH. -->
  <PropertyGroup>
    <BundleFfmpeg Condition="'$(BundleFfmpeg)' == ''">true</BundleFfmpeg>
    <FfmpegBinaryFolder>$(MSBuildThisFileDirectory)..\tools\ffmpeg\win-x64\</FfmpegBinaryFolder>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(BundleFfmpeg)' == 'true'">
    <Content Include="$(FfmpegBinaryFolder)ffmpeg.exe" Condition="Exists('$(FfmpegBinaryFolder)ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ffmpeg.exe</Link>
    </Content>
    <Content Include="$(FfmpegBinaryFolder)ffprobe.exe" Condition="Exists('$(FfmpegBinaryFolder)ffprobe.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ffprobe.exe</Link>
    </Content>
  </ItemGroup>

  <!-- Message, not Warning: CI builds with a bare -warnaserror, which promotes MSBuild warnings
       to errors and would turn a missing optional download back into a broken build. -->
  <Target Name="ReportMissingBundledFfmpeg" BeforeTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(BundleFfmpeg)' == 'true' AND !Exists('$(FfmpegBinaryFolder)ffmpeg.exe')">
    <Message Importance="high"
             Text="ffmpeg is not bundled into the output ($(FfmpegBinaryFolder) is empty). Run 'pwsh tools/download-ffmpeg.ps1' to bundle it, or keep ffmpeg/ffprobe on PATH." />
  </Target>

</Project>
