<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>VirtualContactSheet</PackageId>
    <Version>2.0.0</Version>
    <Authors>Thomas Bruderer</Authors>
    <Description>Contact sheet generator for .NET. Composes a grid of thumbnails - either frames extracted from a video, or the images in a folder or list - with a metadata header, title, per-thumbnail captions, drop shadows and polaroid frames. SkiaSharp does the composition; ffmpeg/ffprobe are used for video capture only, so image contact sheets need neither.</Description>
    <PackageTags>contact-sheet;video;image;photo;thumbnail;grid;ffmpeg;skiasharp;screenshot</PackageTags>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/FreeApophis/vcs-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FreeApophis/vcs-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Source Link is built into the .NET SDK; PublishRepositoryUrl above enables it for GitHub.
         Embed generated/untracked sources (e.g. AssemblyInfo) so step-into debugging never breaks. -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFMpegCore" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <!-- DejaVu Sans (regular + bold) is embedded so the library renders identical text on every
       platform without depending on installed system fonts. License: Fonts/LICENSE. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\DejaVuSans.ttf" />
    <EmbeddedResource Include="Fonts\DejaVuSans-Bold.ttf" />
  </ItemGroup>

</Project>
