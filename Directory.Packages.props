  <ItemGroup>
    <PackageVersion Include="Funcky" Version="3.8.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="FFMpegCore" Version="6.0.0" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="SkiaSharp" Version="4.156.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.156.0" />
    <PackageVersion Include="Tomlyn" Version="2.11.1" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Funcky.XUnit.v3" Version="1.1.0" />
  </ItemGroup>
</Project>