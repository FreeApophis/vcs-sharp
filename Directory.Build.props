<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <FunckyImplicitUsings>enable</FunckyImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>SA1201</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polyadic.CodeStyle" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>

  <!-- Verify (snapshot testing) 33+ fails the build without a SponsorCheck license property.
       vcs-sharp is a non-revenue open-source project, which Verify's maintenance-fee terms exempt:
       https://github.com/VerifyTests/Verify/blob/main/docs/maintenance-fee.md
       The exemption is time-bounded to at most 12 months: once the month below has passed the
       build fails with SC040 and the date has to be renewed. -->
  <PropertyGroup>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-11</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
</Project>