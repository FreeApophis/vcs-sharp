<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <!-- Test fixtures synthesize SkiaSharp bitmaps and hand ownership to Thumbnail/Render
         (which dispose them); the IDisposable analyzers can't track that transfer. -->
    <NoWarn>$(NoWarn);IDISP001;IDISP003;IDISP004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Funcky.XUnit.v3" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualContactSheet.Cli\VirtualContactSheet.Cli.csproj" />
    <ProjectReference Include="..\VirtualContactSheet\VirtualContactSheet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="SkiaSharp" />
    <Using Include="VirtualContactSheet" />
    <Using Include="VirtualContactSheet.VideoProcessing" />
    <Using Include="VirtualContactSheet.ImageProcessing" />
    <Using Include="VerifyXunit" />
    <Using Include="VerifyTests" />
    <Using Include="VerifyXunit.Verifier" Static="true" />
  </ItemGroup>

</Project>