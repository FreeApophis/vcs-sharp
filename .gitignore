# ffmpeg/ffprobe binaries (~200 MB each platform) — not committed to git, and never
# redistributed in the NuGet packages. Run tools/download-ffmpeg.ps1 to populate
# tools/ffmpeg/ locally; the version it fetches is pinned in tools/ffmpeg.json.
tools/ffmpeg/
/VirtualContactSheet.Cli/Properties/launchSettings.json
